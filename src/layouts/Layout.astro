---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Viewer from "../components/Viewer.astro";
interface Props {
  title?: string;
  description?: string;
  hero?: boolean;
}
const {
  title = "Marcus Shih — Photography",
  description = "Photographs by Marcus Shih. Cities, landscapes, and everyday moments, between New York, Tokyo, Busan, and Taiwan.",
  hero = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#161815" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header hero={hero} />
    <slot />
    <Footer />
    <Viewer />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
