---
import { withBase } from "../utils/paths";
interface Props {
  hero?: boolean;
}
const { hero = false } = Astro.props;
const path = Astro.url.pathname;
---

<header class:list={["site-header", { "over-hero": hero }]}>
  <a
    class="wordmark"
    href={withBase("/")}
    aria-label="Marcus Shih photography, home"
  >
    Marcus Shih<span class="wordmark-sub">Photography</span>
  </a>
  <nav aria-label="Main navigation">
    <a
      href={withBase("/")}
      aria-current={path === withBase("/") ? "page" : undefined}
    >
      Selected
    </a>
    <a
      href={withBase("/#collections")}
      aria-current={
        path.startsWith(withBase("/collections/")) ? "location" : undefined
      }
    >
      Collections
    </a>
    <a
      href={withBase("/about/")}
      aria-current={path === withBase("/about/") ? "page" : undefined}
    >
      About
    </a>
  </nav>
</header>
