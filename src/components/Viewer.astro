---
import { allPhotos } from "../data/gallery";
const payload = allPhotos.map(({ photo, album }) => ({
  ...photo,
  album: album.title,
  albumHref: `/collections/${album.slug}/`,
}));
---

<dialog
  class="viewer"
  aria-labelledby="viewer-title"
  aria-describedby="viewer-help"
>
  <div class="viewer-top">
    <p>
      Marcus Shih <span>/ Photography</span>
    </p>
    <button
      class="viewer-close"
      type="button"
      aria-label="Close photograph viewer"
      autofocus
    >
      Close <span aria-hidden="true">×</span>
    </button>
  </div>
  <div class="viewer-stage">
    <img class="viewer-image" alt="" draggable="false" />
    <p class="viewer-status" role="status"></p>
  </div>
  <div class="viewer-bottom">
    <div class="viewer-caption">
      <h2 id="viewer-title"></h2>
      <a class="viewer-album" href="/"></a>
    </div>
    <div class="viewer-controls">
      <button type="button" data-step="-1" aria-label="Previous photograph">
        ←
      </button>
      <p class="viewer-count" aria-live="polite" aria-atomic="true"></p>
      <button type="button" data-step="1" aria-label="Next photograph">
        →
      </button>
    </div>
  </div>
  <details class="viewer-details">
    <summary>Photograph details</summary>
    <dl></dl>
  </details>
  <p class="sr-only" id="viewer-help">
    Use left and right arrow keys to navigate. Press Escape to close. On
    touchscreens, swipe across the photograph.
  </p>
</dialog>
<script
  type="application/json"
  id="photo-data"
  set:html={JSON.stringify(payload).replace(/</g, "\\u003c")}
></script>
<script src="../scripts/viewer.ts"></script>
