---
import { withBase } from "../utils/paths";
import Layout from "../layouts/Layout.astro";
import Gallery from "../components/Gallery.astro";
import {
  albums,
  selectedPhotos,
  coverFor,
  imageFor,
  yearsFor,
  galleryEntries,
} from "../data/gallery";
const hero = coverFor(albums[2]);
const image = imageFor(hero);
---

<Layout hero>
  <main id="main" tabindex="-1">
    <section class="hero home-hero" aria-labelledby="hero-title">
      <img
        class="hero-image"
        src={withBase(hero.src)}
        srcset={image.srcset}
        sizes="100vw"
        width={image.width}
        height={image.height}
        alt={hero.alt}
        fetchpriority="high"
        loading="eager"
      />
      <div class="hero-title">
        <p class="eyebrow">Marcus Shih / Selected photographs</p>
        <h1 id="hero-title">
          Chasing the lights. <span lang="zh-Hant">追逐光.</span>
        </h1>
      </div>
      <div class="hero-bottom">
        <a href="#selected">
          Enter the exhibition <span aria-hidden="true">↓</span>
        </a>
        <p>
          Gwangan Bridge<span>Busan, South Korea · 2026</span>
        </p>
      </div>
    </section>

    <section
      id="selected"
      class="selected-section"
      aria-labelledby="selected-title"
    >
      <div class="section-heading section-shell">
        <h2 class="eyebrow" id="selected-title">
          Selected photographs
        </h2>
      </div>
      <Gallery entries={selectedPhotos} />
    </section>

    <section
      id="collections"
      class="collections-section section-shell"
      aria-labelledby="collections-title"
    >
      <div class="collections-heading" data-reveal>
        <p class="eyebrow">02 / Places</p>
        <h2 id="collections-title">
          Four places.
          <br />
          <em>Many stories.</em>
        </h2>
        <p>Explore the complete collections.</p>
      </div>
      <div class="collection-list">
        {albums.map((album, index) => {
          const photo = coverFor(album);
          const cover = imageFor(photo);
          return (
            <a
              class="collection-link"
              href={withBase(`/collections/${album.slug}/`)}
              data-reveal
            >
              <div class="collection-label">
                <span class="eyebrow">
                  0{index + 1} / {album.region}
                </span>
                <h3>{album.title}</h3>
                <p>
                  {yearsFor(album)}{" "}
                  <span>{galleryEntries(album).length} photographs</span>
                </p>
              </div>
              <div class="collection-image">
                <img
                  src={withBase(photo.src)}
                  srcset={cover.srcset}
                  sizes="(max-width: 700px) 90vw, 40vw"
                  width={cover.width}
                  height={cover.height}
                  alt={photo.alt}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <span class="collection-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          );
        })}
      </div>
    </section>
  </main>
</Layout>
